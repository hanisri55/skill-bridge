# ==============================================================================
# SkillBridge AI — Environment Configuration Template
# ==============================================================================

# Server Runtime Configuration
# - PORT: Assigned automatically by Render / Cloud hosting. Default: 3000 (prod) / 3001 (dev)
# - NODE_ENV: Set to 'production' on Render / cloud, or 'development' for local work
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL)
# - For local development: Leave blank to use embedded PGlite in ./data/postgres
# - For production on Render: Injected automatically by render.yaml blueprint
# - For external PostgreSQL (Supabase, Neon, AWS RDS):
#   DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Authentication & Security
# - Strong secret key used for signing JWT authentication tokens (at least 32 characters)
# - In Render: render.yaml automatically generates this with generateValue: true
JWT_SECRET=your-secure-jwt-secret-at-least-32-chars-long!
